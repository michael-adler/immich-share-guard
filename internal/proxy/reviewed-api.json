        "type": "string"
      },
      "body multipart/form-data field metadata": {
        "items": {
          "properties": {
            "key": {
              "type": "string"
            },
            "value": {
              "additionalProperties": {},
              "type": "object"
            }
          },
          "required": [
            "key",
            "value"
          ],
          "type": "object"
        },
        "type": "array"
      },
      "body multipart/form-data field sidecarData": {
        "format": "binary",
        "type": "string"
      },
      "body multipart/form-data field visibility": {
        "enum": [
          "archive",
          "hidden",
          "locked",
          "timeline"
        ],
        "type": "string"
      },
      "body multipart/form-data required": [
        "fileCreatedAt",
        "fileModifiedAt"
      ],
      "body required": true,
      "header X-Immich-Checksum": {
        "required": false,
        "schema": {
          "type": "string"
        }
