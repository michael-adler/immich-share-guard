# immich-share-guard settings. Copy to .env (or pass the path with -env) and
# edit. Variables set in the environment override this file. Run
# immich-share-guard -h for the full list.

# Internal Immich URL, not one that goes through another TLS proxy. Required.
SHARE_GUARD_UPSTREAM=http://127.0.0.1:2283

# Address to listen on.
SHARE_GUARD_LISTEN=127.0.0.1:2284

# "enforce" blocks disallowed requests, "log" forwards them and logs
# "would block".
SHARE_GUARD_MODE=enforce

# Comma-separated addresses or CIDRs of the front end, whose X-Forwarded-*
# headers are trusted.
SHARE_GUARD_TRUSTED_PROXIES=127.0.0.1,::1

# Custom-URL shares (/s/<slug>) are guessable.
#SHARE_GUARD_ALLOW_SLUGS=false

# Uploads to shares that permit them. Upload bodies are streamed unvalidated.
#SHARE_GUARD_ALLOW_UPLOAD=false

# API failures per client IP per window before blocking (0 disables).
#SHARE_GUARD_FAIL_LIMIT=30
#SHARE_GUARD_FAIL_WINDOW=10m

# How long a successful share password check is cached (0 checks every request).
#SHARE_GUARD_SHARE_CHECK_TTL=1m

# Largest validated request body, and largest JSON response that is rewritten,
# in bytes.
#SHARE_GUARD_MAX_BODY=8388608
#SHARE_GUARD_MAX_SCRUB_BODY=67108864

# How often to fetch the Immich spec again to detect an upgrade (0 checks only
# at startup).
#SHARE_GUARD_SPEC_INTERVAL=15m
